{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentry.bio/bar/schemas/observation.v1.json",
  "title": "BAR Observation v1",
  "type": "object",
  "required": ["record_type", "spec_version", "payload"],
  "properties": {
    "record_type": {"const": "observation"},
    "spec_version": {"const": "bar-1.0"},
    "content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": [
        "sequence_sha256",
        "length_bp",
        "alphabet",
        "normalization_policy",
        "window_policy"
      ],
      "properties": {
        "sequence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "length_bp": {"type": "integer", "minimum": 0},
        "alphabet": {"enum": ["DNA", "RNA", "PROTEIN"]},
        "normalization_policy": {"type": "string", "minLength": 1},
        "window_policy": {"type": "string", "minLength": 1},
        "accession": {"type": ["string", "null"]},
        "assembly_accession": {"type": ["string", "null"]},
        "source": {"type": "object"},
        "quality": {"type": "object"},
        "sequence": {"type": "string"}
      },
      "additionalProperties": true
    },
    "signatures": {"type": "array"}
  },
  "additionalProperties": true
}
