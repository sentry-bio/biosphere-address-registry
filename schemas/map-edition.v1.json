{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentry.bio/bar/schemas/map-edition.v1.json",
  "title": "BAR Map Edition v1",
  "type": "object",
  "required": ["record_type", "spec_version", "payload"],
  "properties": {
    "record_type": {"const": "map-edition"},
    "spec_version": {"const": "bar-1.0"},
    "content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": [
        "map_id",
        "encoder_id",
        "tokenizer_id",
        "reference_manifest_id",
        "metric_id",
        "embedding_dim",
        "index_tiers",
        "verification"
      ],
      "properties": {
        "map_id": {"type": "string", "minLength": 1},
        "encoder_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "reference_manifest_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "metric_id": {"type": "string", "minLength": 1},
        "embedding_dim": {"type": "integer", "minimum": 1},
        "index_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "window_bp", "index_id", "encoder_id"],
            "properties": {
              "name": {"type": "string"},
              "window_bp": {"type": "integer", "minimum": 1},
              "token_count": {"type": "integer", "minimum": 1},
              "index_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "encoder_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "vector_count": {"type": "integer", "minimum": 0},
              "genome_count": {"type": "integer", "minimum": 0},
              "index_type": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "calibration_ids": {"type": "array", "items": {"type": "string"}},
        "routing_policy": {"type": "object"},
        "verification": {"type": "object"},
        "numerics": {"type": "object"},
        "status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "signatures": {"type": "array"}
  },
  "additionalProperties": true
}
